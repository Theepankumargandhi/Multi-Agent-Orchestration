# Model providers (set at least one)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GUARD_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG embeddings: "openai" (needs credits) or "local" (free all-MiniLM-L6-v2 via ChromaDB ONNX).
# Re-run scripts/ingestion/ingest_repo_docs.py after switching; each backend has its own collection.
RAG_EMBEDDING_BACKEND=openai
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_GUARD_MODEL=openai/gpt-oss-safeguard-20b
# Groq's free tier gives the safeguard model 2,000 tokens/minute: about 3 quick checks,
# then ~20 s waits. openai/gpt-oss-20b has 8,000/minute and matched its safe/unsafe
# verdicts on our probes, with less precise categories.
GROQ_GUARD_REASONING_EFFORT=low
# Model for requests that name none, listed first for the UIs. Empty: OpenAI if its
# key is set, otherwise Groq. Set it when a configured key has no credits.
DEFAULT_CHAT_MODEL=
# RAG reranker; a namespaced ID such as openai/gpt-oss-20b runs on Groq.
RAG_RERANK_MODEL=gpt-4o-mini

# API/auth
APP_ENV=development
ENABLE_USER_AUTH=true
# Generate a private random signing key (at least 32 characters) for production.
# Empty uses a process-local random key in development only.
USER_AUTH_SECRET=
USER_AUTH_TOKEN_TTL_SECONDS=86400
MAX_REQUEST_BYTES=65536
RATE_LIMIT_REQUESTS=60
ENABLE_EVAL_API=false
# Comma-separated authenticated user IDs; empty denies all evaluation-report access.
EVAL_ADMIN_USER_IDS=
EVAL_RESULTS_DIR=data/evaluations
RATE_LIMIT_WINDOW_SECONDS=60
POSTGRES_POOL_MAX_SIZE=10

# Optional learned model routing (train artifact with evals.train_cost_router)
ADAPTIVE_MODEL_ROUTER_ENABLED=false
ADAPTIVE_MODEL_ROUTER_PATH=data/evaluations/cost_router.json
ADAPTIVE_SMALL_MODEL=gpt-4o-mini
ADAPTIVE_STRONG_MODEL=

# Optional next-generation multi-model contextual bandit (takes precedence over legacy routing)
CONTEXTUAL_BANDIT_ROUTER_ENABLED=false
CONTEXTUAL_BANDIT_POLICY_PATH=data/evaluations/bandit/policy.json
# Keep at zero until the offline policy gate passes; capped at 0.25 by the service.
CONTEXTUAL_BANDIT_EPSILON=0

# Optional production LLM inference control plane
MODEL_GATEWAY_ENABLED=false
MODEL_GATEWAY_POLICY_VERSION=inference-policy-v1
MODEL_GATEWAY_FINGERPRINT_KEY=
MODEL_GATEWAY_DAILY_BUDGET_USD=5
MODEL_GATEWAY_MAX_PROMPT_TOKENS=16000
MODEL_GATEWAY_MAX_COMPLETION_TOKENS=1024
MODEL_GATEWAY_TIMEOUT_MS=30000
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_COOLDOWN_SECONDS=30
MODEL_GATEWAY_SEMANTIC_CACHE_ENABLED=false
MODEL_GATEWAY_SEMANTIC_CACHE_THRESHOLD=0.92
MODEL_GATEWAY_SEMANTIC_CACHE_TTL_SECONDS=900
MODEL_GATEWAY_SEMANTIC_CACHE_MAX_ENTRIES=1000
MODEL_GATEWAY_CANARY_PROVIDER=
MODEL_GATEWAY_CANARY_PERCENTAGE=0
MODEL_GATEWAY_SHADOW_ENABLED=false
MODEL_GATEWAY_SHADOW_PROVIDER=
MODEL_GATEWAY_OPENAI_INPUT_COST_PER_MILLION=0
MODEL_GATEWAY_OPENAI_OUTPUT_COST_PER_MILLION=0
MODEL_GATEWAY_GROQ_INPUT_COST_PER_MILLION=0
MODEL_GATEWAY_GROQ_OUTPUT_COST_PER_MILLION=0
MODEL_GATEWAY_ONLINE_EVENT_PATH=
ONLINE_EVAL_INTEGRITY_KEY=

# Trustworthy long-term agent memory (opt-in; tenant-isolated and integrity-bound)
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_DB_PATH=data/memory/agent_memory.db
AGENT_MEMORY_INTEGRITY_KEY=
AGENT_MEMORY_TOKEN_BUDGET=384

# Claim-level grounding verification (holds draft output until verified)
GROUNDING_VERIFICATION_ENABLED=false
GROUNDING_MIN_CLAIM_SCORE=0.22
GROUNDING_MIN_COVERAGE=0.80
GROUNDING_FAIL_CLOSED=true
GROUNDING_INTEGRITY_KEY=

# Split-conformal selective answering (requires a generated calibrator artifact)
UNCERTAINTY_CALIBRATION_ENABLED=false
UNCERTAINTY_CALIBRATOR_PATH=data/evaluations/uncertainty/calibrator.json
UNCERTAINTY_INTEGRITY_KEY=

# Adaptive test-time compute (requires grounding; uncertainty calibration recommended)
ADAPTIVE_COMPUTE_ENABLED=false
ADAPTIVE_COMPUTE_MAX_CANDIDATES=3
ADAPTIVE_COMPUTE_MAX_EXTRA_TOKENS=1800
ADAPTIVE_COMPUTE_MAX_LATENCY_MS=15000
ADAPTIVE_COMPUTE_INTEGRITY_KEY=

# Process-supervised verifier for adaptive best-of-N candidate selection
PROCESS_REWARD_MODEL_ENABLED=false
PROCESS_REWARD_MODEL_PATH=data/evaluations/process-reward/model.json

# PRM-guided bounded MCTS for retrieve/reason/verify/answer planning
VERIFIER_MCTS_ENABLED=false
VERIFIER_MCTS_ITERATIONS=96
VERIFIER_MCTS_MAX_NODES=128

# Learned action-conditioned dynamics for uncertainty-aware model-predictive MCTS
WORLD_MODEL_ENABLED=false
WORLD_MODEL_PATH=data/evaluations/world-model/world-model.json

# Conservative offline-RL action priors for PUCT planning
OFFLINE_RL_POLICY_ENABLED=false
OFFLINE_RL_POLICY_PATH=data/evaluations/offline-rl/offline-rl-policy.json

# Search-visit distilled PUCT priors (select this OR offline-RL priors)
SEARCH_DISTILLATION_ENABLED=false
SEARCH_DISTILLATION_PATH=data/evaluations/distillation/policy.json

# Calibrated bootstrapped verifier ensemble and private active-learning queue
VERIFIER_ENSEMBLE_ENABLED=false
VERIFIER_ENSEMBLE_PATH=data/evaluations/verifier-uncertainty/ensemble.json
VERIFIER_ACTIVE_LEARNING_ENABLED=false
VERIFIER_ACTIVE_LEARNING_PATH=data/verifier-review/verifier-review.sqlite3
VERIFIER_REVIEW_UNCERTAINTY_THRESHOLD=0.08

# Pre-synthesis evidence quality and conflict adjudication
EVIDENCE_QUALITY_ENABLED=false
EVIDENCE_MIN_WEB_SOURCES=2
EVIDENCE_DUPLICATE_SIMILARITY=0.82
EVIDENCE_AUTHORITY_DOMAINS=openai.com,github.com,python.org
EVIDENCE_QUALITY_INTEGRITY_KEY=

# Sandboxed coding agent (disabled until a Docker worker and repository root are configured)
CODE_AGENT_ENABLED=false
# Explicit relative repository IDs offered by the browser Workbench. Empty disables new UI submissions.
# Repositories must already exist below CODE_AGENT_REPOSITORY_ROOT. No directory is scanned or uploaded.
WORKBENCH_REPOSITORIES=
# Opt-in document Workbench. Requires local Docker and the dedicated image; no provider calls.
WORKBENCH_DOCUMENTS_ENABLED=false
WORKBENCH_DOCUMENT_DB=data/workbench-documents/library.db
CODE_AGENT_REPOSITORY_ROOT=repositories
CODE_AGENT_IMAGE=agentforge-code-sandbox:local
CODE_AGENT_NETWORK_ENABLED=false
CODE_AGENT_SECURITY_POLICY_ENABLED=true
CODE_AGENT_SECURITY_POLICY_VERSION=agentforge-security-v1
CODE_AGENT_MAX_CONCURRENCY=1
CODE_AGENT_EXECUTION_MODE=embedded
CODE_AGENT_WORKFLOW=verified_pr
CODE_AGENT_DB_PATH=data/code-agent/jobs.db
CODE_AGENT_ARTIFACT_ROOT=data/code-agent/artifacts
CODE_AGENT_MAX_ARTIFACT_BYTES=4000000
CODE_AGENT_MAX_RECORDS=5000
CODE_AGENT_MAX_ATTEMPTS=3
CODE_AGENT_LEASE_SECONDS=90
CODE_AGENT_MAX_ITERATIONS=20
CODE_AGENT_MAX_WRITES=8
CODE_AGENT_MAX_CHANGED_FILES=20
CODE_AGENT_MAX_REPAIR_ROUNDS=2
CODE_AGENT_MAX_WORKFLOW_WRITES=16
CODE_AGENT_TARGETED_EDITS_ONLY=true
CODE_AGENT_DELIVERY_VERIFICATION_ENABLED=true
CODE_AGENT_REQUIRE_SPECIALISTS=true
CODE_AGENT_MAX_COMPLETION_TOKENS=4096
CODE_AGENT_PROVIDER_TIMEOUT_SECONDS=30

# Optional private AI incident investigation (separate from content-free telemetry).
# Generate a private random 32-byte key and encode as 64 hex characters. Never commit it.
INCIDENT_INVESTIGATION_ENABLED=false
INCIDENT_LIVE_REPLAY_ENABLED=false
INCIDENT_RUNTIME_CAPTURE_ENABLED=false
INCIDENT_WORKER_LIVE_ENABLED=false
INCIDENT_CAPTURE_TTL_SECONDS=86400
INCIDENT_DB_PATH=data/incidents/private.db
INCIDENT_ENCRYPTION_KEY=
# Opt-in, local execution-guided context; caps apply per coding stage.
CODE_AGENT_EXECUTION_RETRIEVAL_ENABLED=false
CODE_AGENT_EXECUTION_RETRIEVAL_MAX_REFRESHES=4
CODE_AGENT_EXECUTION_RETRIEVAL_MAX_TOKENS=1024
# Optional Python/pytest spectrum localization; repeated fresh Docker probes per stage.
CODE_AGENT_FAULT_LOCALIZATION_ENABLED=false
CODE_AGENT_FAULT_LOCALIZATION_MAX_REFRESHES=2
CODE_AGENT_FAULT_LOCALIZATION_TIMEOUT_SECONDS=120
CODE_AGENT_FAULT_LOCALIZATION_MAX_TOKENS=768
# Verified-PR-only, opt-in file-level patch ablation before final review.
CODE_AGENT_PATCH_MINIMIZATION_ENABLED=false
CODE_AGENT_PATCH_MINIMIZATION_MAX_FILES=3
CODE_AGENT_PATCH_MINIMIZATION_TIMEOUT_SECONDS=180
# Stage-local cycle detection: off, shadow (no prompt change), or enforce.
CODE_AGENT_LOOP_GUARD_MODE=off
CODE_AGENT_LOOP_GUARD_REPETITION_LIMIT=3
CODE_AGENT_LOOP_GUARD_MAX_CYCLE_LENGTH=4
# Verified-PR patch-targeted regression-test sensitivity: off, report, enforce.
CODE_AGENT_MUTATION_TESTING_MODE=off
CODE_AGENT_MUTATION_TESTING_MAX_MUTANTS=3
CODE_AGENT_MUTATION_TESTING_MIN_MUTANTS=1
CODE_AGENT_MUTATION_TESTING_MIN_SCORE=1.0
CODE_AGENT_MUTATION_TESTING_TIMEOUT_SECONDS=180
# Owner-reviewed repair lessons; tenant namespace comes from authentication.
CODE_AGENT_REPAIR_MEMORY_ENABLED=false
CODE_AGENT_REPAIR_MEMORY_PROJECT=
CODE_AGENT_REPAIR_MEMORY_PATH=data/code-agent/repair-memory.db
# Additional Docker-only original-fail/patched-pass pytest gate; off by default.
CODE_AGENT_COUNTERFACTUAL_VERIFICATION_ENABLED=false
CODE_AGENT_COUNTERFACTUAL_TIMEOUT_SECONDS=180
CODE_AGENT_MIN_CHANGED_LINE_COVERAGE=0.8
CODE_AGENT_INPUT_COST_PER_MILLION=0
CODE_AGENT_OUTPUT_COST_PER_MILLION=0
CODE_AGENT_TASK_TIMEOUT_SECONDS=900

# Code Intelligence V2 (offline defaults; learned backends require the optional ML requirements)
CODE_CONTEXT_TREE_SITTER=true
CODE_CONTEXT_STRATEGY=hybrid_rerank
CODE_CONTEXT_PACKING_POLICY=legacy
## Optional multi-team repair exploration; current workflow remains unchanged unless explicitly selected.
# CODE_AGENT_WORKFLOW=repair_tournament
CODE_TOURNAMENT_CANDIDATES=3
CODE_TOURNAMENT_MAX_PARALLEL=2
CODE_TOURNAMENT_MAX_MODEL_CALLS=64
CODE_TOURNAMENT_PROMPT_TOKEN_BUDGET=100000
CODE_TOURNAMENT_CANDIDATE_TIMEOUT_SECONDS=300
CODE_TOURNAMENT_CHALLENGE_TIMEOUT_SECONDS=60
# Opt-in sequential supervisor; verified_pr stays the default.
# CODE_AGENT_WORKFLOW=adaptive_supervisor
# Optional operator-owned overrides; blank uses validated defaults and forces max_parallel=1.
CODE_ADAPTIVE_DISPATCH_POLICY_JSON=
# Optional pinned categorical advisor; shadow recommendations NEVER alter serving dispatch.
# Declare advisor_shadow.artifact_fingerprint and advisor_shadow.scope_sha256 in the policy above.
CODE_ADAPTIVE_DISPATCH_ARTIFACT=
# Optional operator-owned Python probe targets; blank disables regression generation.
CODE_TOURNAMENT_REGRESSION_POLICY_JSON=
# Optional private reference directory, only used when oracle_calibration is explicitly configured.
# Must be absolute and separate from task repositories. Never use a public deployment's API host.
CODE_TOURNAMENT_REFERENCE_REPOSITORY=
# Example for the authored clamp fixture ONLY; choose your repository's public targets.
# CODE_TOURNAMENT_REGRESSION_POLICY_JSON={"allowed_targets":["app.clamp"],"max_probes":8,"generation_timeout_seconds":60}
CODE_CONTEXT_TOP_K=8
CODE_CONTEXT_MAX_TOKENS=4096
CODE_CONTEXT_EMBEDDING_BACKEND=hashing
CODE_CONTEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CODE_CONTEXT_RERANKER_BACKEND=feature
CODE_CONTEXT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional integrity-checked pairwise learning-to-rank artifact.
CODE_CONTEXT_FUSION_ARTIFACT=

# Persistence
CHECKPOINT_DB_PATH=data/checkpoints/checkpoints.db
STORE_DB_PATH=data/store/store.db
POSTGRES_CHECKPOINT_URI=
POSTGRES_STORE_URI=
CHECKPOINT_FALLBACK_SQLITE=true
STORE_FALLBACK_SQLITE=true

# Retrieval
USE_CHROMA_RAG=true
CHROMA_PERSIST_DIR=data/chroma_db
GRAPH_RAG_ENABLED=true
GRAPH_CHROMA_PERSIST_DIR=data/graph_chroma_db
CACHE_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
# Compose requires privately generated passwords; use a URL-safe PostgreSQL value.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Human approval and tools
GRAPH_WEB_HITL_ENABLED=true
SAFETY_FAIL_CLOSED=true
ALLOW_LEGACY_HITL_CONTROL=false
MCP_TOOLS_ENABLED=false

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evidence-agent-platform
GENAI_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentforge-agent-service
GENAI_TRACE_JSONL_PATH=
GENAI_TRACE_MAX_BYTES=10000000

# Private execution feedback (disabled without per-request consent and tenant identity).
EXECUTION_REPLAY_ENABLED=false
EXECUTION_REPLAY_PATH=data/execution-replay/replay.sqlite3
# Set locally to an independent random secret of at least 32 bytes; never commit it.
EXECUTION_REPLAY_KEY=

# Optional reviewed-metadata preference reranking, AFTER all existing release gates.
PREFERENCE_RANKING_ENABLED=false
# Owner-reviewed, tenant-bound artifact. Never point this at a synthetic drill model.
PREFERENCE_RANKING_PATH=data/evaluations/preferences/active.json
# Independent random secret of at least 32 bytes, distinct from EXECUTION_REPLAY_KEY.
PREFERENCE_RANKING_KEY=

# Non-serving preference comparisons. Requires replay consent and a preregistered study.
# Keep PREFERENCE_RANKING_ENABLED=false while collecting shadow evidence.
PREFERENCE_SHADOW_ENABLED=false
PREFERENCE_SHADOW_STUDY_ID=
# Optional stronger activation gate: signed, fresh, model/policy/scope-bound approval.
PREFERENCE_RANKING_REQUIRE_SHADOW_APPROVAL=false
PREFERENCE_SHADOW_APPROVAL_PATH=data/evaluations/preference-shadow/approval.json

# Optional tenant deployment registry and live delayed-outcome sentinel.
# Requires owner activation, ranking, replay consent and preassigned task families.
# Uses the replay SQLite DB; no autonomous promotion or lease renewal.
PREFERENCE_DEPLOYMENT_ENABLED=false

# Optional pre-review workflow snapshots; never changes answers or activates a model.
# Requires replay consent, tenant identity and a preassigned task family.
PROCESS_SUPERVISION_ENABLED=false
# Independent random secret of at least 32 bytes, distinct from EXECUTION_REPLAY_KEY.
# Used only by offline candidate-model export. Set locally; never commit real secrets.
PROCESS_SUPERVISION_MODEL_KEY=

# Non-serving verifier comparisons against a preregistered study.
# Requires process snapshots, replay consent, and PREFERENCE_RANKING_ENABLED=false.
VERIFIER_SHADOW_ENABLED=false
VERIFIER_SHADOW_STUDY_ID=
# Non-serving reviewed step-ensemble to final-answer outcome comparisons.
# Requires replay + process supervision, consent, and a preregistered study.
ENSEMBLE_OUTCOME_SHADOW_ENABLED=false
ENSEMBLE_OUTCOME_SHADOW_STUDY_ID=
# Per-user coding repository grants. Empty means no coding repository access.
# Use an explicit "*" owner only for repositories shared with every authenticated user.
CODE_AGENT_REPOSITORY_GRANTS={}
