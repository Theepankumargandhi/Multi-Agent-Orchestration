# Model providers (set at least one)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GUARD_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# API/auth
APP_ENV=development
ENABLE_USER_AUTH=true
USER_AUTH_SECRET=replace-with-at-least-32-random-characters
USER_AUTH_TOKEN_TTL_SECONDS=86400
MAX_REQUEST_BYTES=65536
RATE_LIMIT_REQUESTS=60
ENABLE_EVAL_API=false
EVAL_RESULTS_DIR=data/evaluations
RATE_LIMIT_WINDOW_SECONDS=60
POSTGRES_POOL_MAX_SIZE=10

# Optional learned model routing (train artifact with evals.train_cost_router)
ADAPTIVE_MODEL_ROUTER_ENABLED=false
ADAPTIVE_MODEL_ROUTER_PATH=data/evaluations/cost_router.json
ADAPTIVE_SMALL_MODEL=gpt-4o-mini
ADAPTIVE_STRONG_MODEL=

# Optional next-generation multi-model contextual bandit (takes precedence over legacy routing)
CONTEXTUAL_BANDIT_ROUTER_ENABLED=false
CONTEXTUAL_BANDIT_POLICY_PATH=data/evaluations/bandit/policy.json
# Keep at zero until the offline policy gate passes; capped at 0.25 by the service.
CONTEXTUAL_BANDIT_EPSILON=0

# Optional production LLM inference control plane
MODEL_GATEWAY_ENABLED=false
MODEL_GATEWAY_POLICY_VERSION=inference-policy-v1
MODEL_GATEWAY_FINGERPRINT_KEY=replace-with-at-least-16-random-characters
MODEL_GATEWAY_DAILY_BUDGET_USD=5
MODEL_GATEWAY_MAX_PROMPT_TOKENS=16000
MODEL_GATEWAY_MAX_COMPLETION_TOKENS=1024
MODEL_GATEWAY_TIMEOUT_MS=30000
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_COOLDOWN_SECONDS=30
MODEL_GATEWAY_SEMANTIC_CACHE_ENABLED=false
MODEL_GATEWAY_SEMANTIC_CACHE_THRESHOLD=0.92
MODEL_GATEWAY_SEMANTIC_CACHE_TTL_SECONDS=900
MODEL_GATEWAY_SEMANTIC_CACHE_MAX_ENTRIES=1000
MODEL_GATEWAY_CANARY_PROVIDER=
MODEL_GATEWAY_CANARY_PERCENTAGE=0
MODEL_GATEWAY_SHADOW_ENABLED=false
MODEL_GATEWAY_SHADOW_PROVIDER=
MODEL_GATEWAY_OPENAI_INPUT_COST_PER_MILLION=0
MODEL_GATEWAY_OPENAI_OUTPUT_COST_PER_MILLION=0
MODEL_GATEWAY_GROQ_INPUT_COST_PER_MILLION=0
MODEL_GATEWAY_GROQ_OUTPUT_COST_PER_MILLION=0
MODEL_GATEWAY_ONLINE_EVENT_PATH=
ONLINE_EVAL_INTEGRITY_KEY=replace-with-a-separate-16-character-minimum-secret

# Trustworthy long-term agent memory (opt-in; tenant-isolated and integrity-bound)
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_DB_PATH=data/memory/agent_memory.db
AGENT_MEMORY_INTEGRITY_KEY=replace-with-at-least-16-random-characters
AGENT_MEMORY_TOKEN_BUDGET=384

# Claim-level grounding verification (holds draft output until verified)
GROUNDING_VERIFICATION_ENABLED=false
GROUNDING_MIN_CLAIM_SCORE=0.22
GROUNDING_MIN_COVERAGE=0.80
GROUNDING_FAIL_CLOSED=true
GROUNDING_INTEGRITY_KEY=replace-with-a-dedicated-16-character-minimum-secret

# Split-conformal selective answering (requires a generated calibrator artifact)
UNCERTAINTY_CALIBRATION_ENABLED=false
UNCERTAINTY_CALIBRATOR_PATH=data/evaluations/uncertainty/calibrator.json
UNCERTAINTY_INTEGRITY_KEY=replace-with-a-separate-16-character-minimum-secret

# Adaptive test-time compute (requires grounding; uncertainty calibration recommended)
ADAPTIVE_COMPUTE_ENABLED=false
ADAPTIVE_COMPUTE_MAX_CANDIDATES=3
ADAPTIVE_COMPUTE_MAX_EXTRA_TOKENS=1800
ADAPTIVE_COMPUTE_MAX_LATENCY_MS=15000
ADAPTIVE_COMPUTE_INTEGRITY_KEY=replace-with-another-16-character-minimum-secret

# Process-supervised verifier for adaptive best-of-N candidate selection
PROCESS_REWARD_MODEL_ENABLED=false
PROCESS_REWARD_MODEL_PATH=data/evaluations/process-reward/model.json

# PRM-guided bounded MCTS for retrieve/reason/verify/answer planning
VERIFIER_MCTS_ENABLED=false
VERIFIER_MCTS_ITERATIONS=96
VERIFIER_MCTS_MAX_NODES=128

# Learned action-conditioned dynamics for uncertainty-aware model-predictive MCTS
WORLD_MODEL_ENABLED=false
WORLD_MODEL_PATH=data/evaluations/world-model/world-model.json

# Conservative offline-RL action priors for PUCT planning
OFFLINE_RL_POLICY_ENABLED=false
OFFLINE_RL_POLICY_PATH=data/evaluations/offline-rl/offline-rl-policy.json

# Search-visit distilled PUCT priors (select this OR offline-RL priors)
SEARCH_DISTILLATION_ENABLED=false
SEARCH_DISTILLATION_PATH=data/evaluations/distillation/policy.json

# Calibrated bootstrapped verifier ensemble and private active-learning queue
VERIFIER_ENSEMBLE_ENABLED=false
VERIFIER_ENSEMBLE_PATH=data/evaluations/verifier-uncertainty/ensemble.json
VERIFIER_ACTIVE_LEARNING_ENABLED=false
VERIFIER_ACTIVE_LEARNING_PATH=data/verifier-review/verifier-review.sqlite3
VERIFIER_REVIEW_UNCERTAINTY_THRESHOLD=0.08

# Pre-synthesis evidence quality and conflict adjudication
EVIDENCE_QUALITY_ENABLED=false
EVIDENCE_MIN_WEB_SOURCES=2
EVIDENCE_DUPLICATE_SIMILARITY=0.82
EVIDENCE_AUTHORITY_DOMAINS=openai.com,github.com,python.org
EVIDENCE_QUALITY_INTEGRITY_KEY=replace-with-an-independent-16-character-minimum-secret

# Sandboxed coding agent (disabled until a Docker worker and repository root are configured)
CODE_AGENT_ENABLED=false
CODE_AGENT_REPOSITORY_ROOT=repositories
CODE_AGENT_IMAGE=agentforge-code-sandbox:local
CODE_AGENT_NETWORK_ENABLED=false
CODE_AGENT_SECURITY_POLICY_ENABLED=true
CODE_AGENT_SECURITY_POLICY_VERSION=agentforge-security-v1
CODE_AGENT_MAX_CONCURRENCY=1
CODE_AGENT_EXECUTION_MODE=embedded
CODE_AGENT_WORKFLOW=verified_pr
CODE_AGENT_DB_PATH=data/code-agent/jobs.db
CODE_AGENT_ARTIFACT_ROOT=data/code-agent/artifacts
CODE_AGENT_MAX_ARTIFACT_BYTES=4000000
CODE_AGENT_MAX_RECORDS=5000
CODE_AGENT_MAX_ATTEMPTS=3
CODE_AGENT_LEASE_SECONDS=90
CODE_AGENT_MAX_ITERATIONS=20
CODE_AGENT_MAX_WRITES=8
CODE_AGENT_MAX_CHANGED_FILES=20
CODE_AGENT_MAX_REPAIR_ROUNDS=2
CODE_AGENT_MAX_WORKFLOW_WRITES=16
CODE_AGENT_MIN_CHANGED_LINE_COVERAGE=0.8
CODE_AGENT_INPUT_COST_PER_MILLION=0
CODE_AGENT_OUTPUT_COST_PER_MILLION=0
CODE_AGENT_TASK_TIMEOUT_SECONDS=900

# Code Intelligence V2 (offline defaults; learned backends require the optional ML requirements)
CODE_CONTEXT_TREE_SITTER=true
CODE_CONTEXT_STRATEGY=hybrid_rerank
CODE_CONTEXT_TOP_K=8
CODE_CONTEXT_MAX_TOKENS=4096
CODE_CONTEXT_EMBEDDING_BACKEND=hashing
CODE_CONTEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CODE_CONTEXT_RERANKER_BACKEND=feature
CODE_CONTEXT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional integrity-checked pairwise learning-to-rank artifact.
CODE_CONTEXT_FUSION_ARTIFACT=

# Persistence
CHECKPOINT_DB_PATH=data/checkpoints/checkpoints.db
STORE_DB_PATH=data/store/store.db
POSTGRES_CHECKPOINT_URI=
POSTGRES_STORE_URI=
CHECKPOINT_FALLBACK_SQLITE=true
STORE_FALLBACK_SQLITE=true

# Retrieval
USE_CHROMA_RAG=true
CHROMA_PERSIST_DIR=data/chroma_db
GRAPH_RAG_ENABLED=true
GRAPH_CHROMA_PERSIST_DIR=data/graph_chroma_db
CACHE_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Human approval and tools
GRAPH_WEB_HITL_ENABLED=true
SAFETY_FAIL_CLOSED=true
ALLOW_LEGACY_HITL_CONTROL=false
MCP_TOOLS_ENABLED=false

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=evidence-agent-platform
GENAI_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentforge-agent-service
GENAI_TRACE_JSONL_PATH=
GENAI_TRACE_MAX_BYTES=10000000
