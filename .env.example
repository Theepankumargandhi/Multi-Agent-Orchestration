# Copy to .env and fill in at least one provider key. Everything else has a working default.

# --- Model providers (set at least one) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_GUARD_MODEL=openai/gpt-oss-safeguard-20b
# Groq's free tier gives the safeguard model 2,000 tokens/minute: about 3 quick checks,
# then ~20 s waits. openai/gpt-oss-20b has 8,000/minute and matched its safe/unsafe
# verdicts on our probes, with less precise categories.
GROQ_GUARD_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GUARD_MODEL=gpt-4o-mini
# Model for requests that name none, listed first in the UI. Empty: OpenAI if its key is
# set, otherwise Groq. Set it when a configured key has no credits.
DEFAULT_CHAT_MODEL=

# --- Answer checking ---
# Hold each answer until its claims and citations are checked against the evidence;
# unsupported or contradicted claims are removed, and the answer abstains if nothing survives.
GROUNDING_VERIFICATION_ENABLED=true
GROUNDING_MIN_CLAIM_SCORE=0.22
GROUNDING_MIN_COVERAGE=0.80
GROUNDING_FAIL_CLOSED=true
# Before writing an answer, drop duplicate, stale, injected or conflicting web evidence.
# Web answers then need at least EVIDENCE_MIN_WEB_SOURCES independent sources.
EVIDENCE_QUALITY_ENABLED=false
EVIDENCE_MIN_WEB_SOURCES=2
EVIDENCE_DUPLICATE_SIMILARITY=0.82
EVIDENCE_AUTHORITY_DOMAINS=openai.com,github.com,python.org
# Refuse requests when the safety check itself fails.
SAFETY_FAIL_CLOSED=true

# --- Your documents (RAG) ---
# "local" is free (all-MiniLM-L6-v2 via ChromaDB ONNX); "openai" needs API credits.
# Each backend has its own collection: re-run ingestion after switching.
RAG_EMBEDDING_BACKEND=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
USE_CHROMA_RAG=true
CHROMA_PERSIST_DIR=data/chroma_db
RAG_PDF_DIR=rag_docs
GRAPH_RAG_ENABLED=true
GRAPH_CHROMA_PERSIST_DIR=data/graph_chroma_db
GRAPH_RAG_PDF_DIR=graph_rag_docs
# Optional LLM reranker; a namespaced ID such as openai/gpt-oss-20b runs on Groq.
RAG_ENABLE_LLM_RERANKER=true
RAG_RERANK_MODEL=openai/gpt-oss-20b

# --- Web search ---
# Ask the user before each live web search.
GRAPH_WEB_HITL_ENABLED=true
GRAPH_WEB_HITL_MAX_RESULTS=5

# --- API and accounts ---
APP_ENV=development
ENABLE_USER_AUTH=true
# Private random signing key (at least 32 characters) for production.
# Empty uses a process-local random key in development only.
USER_AUTH_SECRET=
USER_AUTH_TOKEN_TTL_SECONDS=86400
MAX_REQUEST_BYTES=65536
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Persistence (SQLite by default; set the Postgres URIs to use Postgres) ---
CHECKPOINT_DB_PATH=data/checkpoints/checkpoints.db
STORE_DB_PATH=data/store/store.db
LOCAL_RAG_DB_PATH=data/rag/local_rag.db
POSTGRES_CHECKPOINT_URI=
POSTGRES_STORE_URI=
CACHE_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Long-term memory (opt-in, per user) ---
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_DB_PATH=data/memory/agent_memory.db
AGENT_MEMORY_INTEGRITY_KEY=
AGENT_MEMORY_TOKEN_BUDGET=384

# --- Optional ---
# Run the calculator and web search through a local MCP tool server.
MCP_TOOLS_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=citeright
