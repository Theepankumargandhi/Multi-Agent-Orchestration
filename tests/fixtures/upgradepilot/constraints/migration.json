{
  "task_id": "field-regex",
  "family": "pydantic-field-constraints",
  "source_paths": ["app"],
  "test_command": ["-m", "pytest", "-q", "owner_checks.py"],
  "contracts": [
    {"case_id": "valid", "entrypoint": "app.models:normalize", "args": [{"code": "AB"}]},
    {"case_id": "lowercase", "entrypoint": "app.models:normalize", "args": [{"code": "ab"}], "expected_kind": "error", "expected_error": "ValidationError"},
    {"case_id": "too-long", "entrypoint": "app.models:normalize", "args": [{"code": "ABCD"}], "expected_kind": "error", "expected_error": "ValidationError"}
  ]
}
