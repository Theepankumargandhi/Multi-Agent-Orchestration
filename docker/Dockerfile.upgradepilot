FROM python:3.11-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY docker/upgradepilot-v1.txt docker/upgradepilot-v2.txt docker/upgradepilot-codemod.txt /opt/locks/
RUN python -m venv /opt/v1 && python -m venv /opt/v2 && python -m venv /opt/codemod \
    && /opt/v1/bin/pip install --only-binary=:all: -r /opt/locks/upgradepilot-v1.txt \
    && /opt/v2/bin/pip install --only-binary=:all: -r /opt/locks/upgradepilot-v2.txt \
    && /opt/codemod/bin/pip install --only-binary=:all: -r /opt/locks/upgradepilot-codemod.txt
COPY code_agent/upgrade_probe.py /opt/upgradepilot/probe.py
COPY code_agent/upgrade_schema_probe.py /opt/upgradepilot/schema_probe.py
COPY code_agent/upgrade_session_probe.py /opt/upgradepilot/session_probe.py
WORKDIR /workspace
USER 65532:65532
CMD ["python", "-c", "import time; time.sleep(10**9)"]
