FROM python:3.12.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CODE_SECURITY_EVAL_DIR=/app/data/evaluations/security

COPY requirements-eval-dashboard.txt .
RUN python -m pip install --no-cache-dir -r requirements-eval-dashboard.txt

COPY code_agent/__init__.py ./code_agent/__init__.py
COPY code_agent/models.py ./code_agent/models.py
COPY code_agent/security_policy.py ./code_agent/security_policy.py
COPY code_agent/security_evaluation.py ./code_agent/security_evaluation.py
COPY code_agent/security_dashboard.py ./code_agent/security_dashboard.py

RUN addgroup --system dashboard && adduser --system --ingroup dashboard --uid 10001 dashboard \
    && mkdir -p /app/data/evaluations/security \
    && chown -R dashboard:dashboard /app
USER dashboard

EXPOSE 8505
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8505/_stcore/health', timeout=2)"

CMD ["streamlit", "run", "code_agent/security_dashboard.py", "--server.address=0.0.0.0", "--server.port=8505", "--server.headless=true"]
