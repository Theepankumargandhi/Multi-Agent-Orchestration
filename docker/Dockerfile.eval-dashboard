FROM python:3.12.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CODE_AGENT_EVAL_DIR=/app/data/evaluations/code-agent

COPY requirements-eval-dashboard.txt .
RUN python -m pip install --no-cache-dir -r requirements-eval-dashboard.txt

COPY code_agent/__init__.py ./code_agent/__init__.py
COPY code_agent/dashboard.py ./code_agent/dashboard.py
COPY code_agent/evaluation_models.py ./code_agent/evaluation_models.py

RUN addgroup --system dashboard && adduser --system --ingroup dashboard --uid 10001 dashboard \
    && mkdir -p /app/data/evaluations/code-agent \
    && chown -R dashboard:dashboard /app
USER dashboard

EXPOSE 8502
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8502/_stcore/health', timeout=2)"

CMD ["streamlit", "run", "code_agent/dashboard.py", "--server.address=0.0.0.0", "--server.port=8502", "--server.headless=true"]
