FROM python:3.12.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AGENTOPS_RESULTS_DIR=/app/data/evaluations \
    AGENTOPS_DATASETS_DIR=/app/evals/datasets

COPY requirements-eval-dashboard.txt .
RUN python -m pip install --no-cache-dir -r requirements-eval-dashboard.txt

COPY evals/reliability_dashboard.py ./evals/reliability_dashboard.py
COPY evals/datasets/genai_telemetry_smoke.jsonl ./evals/datasets/genai_telemetry_smoke.jsonl

RUN addgroup --system dashboard && adduser --system --ingroup dashboard --uid 10001 dashboard \
    && mkdir -p /app/data/evaluations \
    && chown -R dashboard:dashboard /app
USER dashboard

EXPOSE 8506
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8506/_stcore/health', timeout=2)"

CMD ["streamlit", "run", "evals/reliability_dashboard.py", "--server.address=0.0.0.0", "--server.port=8506", "--server.headless=true"]
